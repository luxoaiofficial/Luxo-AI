# GEMINI_API_KEY: Required for Google Gemini AI, Knowledge Embeddings & Nano Banana / Veo calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Core & Free-Tier Multi-Provider API Keys (Optional: unlock respective model families when configured)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
GROQ_API_KEY="MY_GROQ_API_KEY"
CEREBRAS_API_KEY="MY_CEREBRAS_API_KEY"
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"
SAMBANOVA_API_KEY="MY_SAMBANOVA_API_KEY"
COHERE_API_KEY="MY_COHERE_API_KEY"
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# Direct Frontier Provider API Keys (Optional)
OPENAI_API_KEY="MY_OPENAI_API_KEY"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
XAI_API_KEY="MY_XAI_API_KEY"
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
PERPLEXITY_API_KEY="MY_PERPLEXITY_API_KEY"
DASHSCOPE_API_KEY="MY_DASHSCOPE_QWEN_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
