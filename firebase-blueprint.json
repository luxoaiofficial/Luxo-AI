{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Privacy-preserving workspace preferences for an authenticated user (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in workspace.",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarText": {
          "type": "string",
          "description": "Initials for avatar monogram.",
          "minLength": 1,
          "maxLength": 4
        },
        "theme": {
          "type": "string",
          "description": "UI color theme preference.",
          "enum": ["system", "light", "dark"],
          "maxLength": 10
        },
        "voiceName": {
          "type": "string",
          "description": "Preferred voice persona.",
          "minLength": 1,
          "maxLength": 30
        },
        "voiceRate": {
          "type": "number",
          "description": "Speech playback rate."
        },
        "customTone": {
          "type": "string",
          "description": "Selected response tone.",
          "minLength": 1,
          "maxLength": 40
        },
        "customInstructions": {
          "type": "string",
          "description": "Custom instructions configured by user.",
          "maxLength": 1500
        },
        "workspaceType": {
          "type": "string",
          "description": "Selected workspace category.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "avatarText",
        "theme",
        "voiceName",
        "voiceRate",
        "customTone",
        "customInstructions",
        "workspaceType",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicSocialProfile": {
      "title": "PublicSocialProfile",
      "description": "Public community profile isolated from private user data (no email or phone PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name.",
          "minLength": 2,
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "description": "Normalized public username handle.",
          "minLength": 3,
          "maxLength": 28,
          "pattern": "^[a-z0-9_]+$"
        },
        "roleTitle": {
          "type": "string",
          "description": "Short professional headline.",
          "minLength": 2,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "User biography text.",
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar preset identifier or HTTPS/uploads URL.",
          "minLength": 1,
          "maxLength": 500
        },
        "interests": {
          "type": "array",
          "description": "Bounded list of up to 10 interest tags."
        },
        "visibility": {
          "type": "string",
          "description": "Visibility guard for query enforcement.",
          "enum": ["public"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "handle",
        "roleTitle",
        "bio",
        "avatarUrl",
        "interests",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "User bookmark for an event or announcement.",
      "type": "object",
      "properties": {
        "favoriteId": {
          "type": "string",
          "description": "Unique favorite record ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "description": "Whether favorited item is an event or announcement.",
          "enum": ["event", "announcement"],
          "maxLength": 20
        },
        "targetId": {
          "type": "string",
          "description": "Target event or announcement ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["favoriteId", "ownerId", "targetType", "targetId", "createdAt"]
    },
    "SocialConnection": {
      "title": "SocialConnection",
      "description": "Directional social edge representing following and/or friendship.",
      "type": "object",
      "properties": {
        "peerId": {
          "type": "string",
          "description": "Target user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "relationType": {
          "type": "string",
          "description": "Connection state.",
          "enum": ["following", "friend", "both"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["peerId", "ownerId", "relationType", "createdAt", "updatedAt"]
    },
    "PlatformEventDoc": {
      "title": "PlatformEventDoc",
      "description": "Platform calendar event authored by an administrator.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Event title.",
          "minLength": 5,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Event details.",
          "minLength": 12,
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "description": "Event category.",
          "enum": [
            "Konferans & Zirve",
            "Atölye (Workshop)",
            "Topluluk Buluşması",
            "Canlı Yayın & Lansman"
          ],
          "maxLength": 40
        },
        "dateIso": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "description": "Start time HH:mm.",
          "minLength": 5,
          "maxLength": 5
        },
        "endTime": {
          "type": "string",
          "description": "End time HH:mm.",
          "minLength": 5,
          "maxLength": 5
        },
        "location": {
          "type": "string",
          "description": "Physical venue or online stream label.",
          "minLength": 3,
          "maxLength": 140
        },
        "speakerName": {
          "type": "string",
          "description": "Speaker or host name.",
          "minLength": 2,
          "maxLength": 80
        },
        "capacity": {
          "type": "number",
          "description": "Maximum attendee capacity."
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Publication status.",
          "enum": ["published", "archived"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "eventId",
        "title",
        "description",
        "category",
        "dateIso",
        "startTime",
        "endTime",
        "location",
        "speakerName",
        "capacity",
        "createdBy",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformAnnouncementDoc": {
      "title": "PlatformAnnouncementDoc",
