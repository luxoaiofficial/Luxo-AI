    "PlatformEventDoc": {
      "title": "PlatformEventDoc",
      "description": "Platform calendar event authored by an administrator.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Event title.",
          "minLength": 5,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Event details.",
          "minLength": 12,
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "description": "Event category.",
          "enum": [
            "Konferans & Zirve",
            "Atölye (Workshop)",
            "Topluluk Buluşması",
            "Canlı Yayın & Lansman"
          ],
          "maxLength": 40
        },
        "dateIso": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "description": "Start time HH:mm.",
          "minLength": 5,
          "maxLength": 5
        },
        "endTime": {
          "type": "string",
          "description": "End time HH:mm.",
          "minLength": 5,
          "maxLength": 5
        },
        "location": {
          "type": "string",
          "description": "Physical venue or online stream label.",
          "minLength": 3,
          "maxLength": 140
        },
        "speakerName": {
          "type": "string",
          "description": "Speaker or host name.",
          "minLength": 2,
          "maxLength": 80
        },
        "capacity": {
          "type": "number",
          "description": "Maximum attendee capacity."
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Publication status.",
          "enum": ["published", "archived"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
