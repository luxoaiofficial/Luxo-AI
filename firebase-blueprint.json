    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Privacy-preserving workspace preferences for an authenticated user (zero PII).",
