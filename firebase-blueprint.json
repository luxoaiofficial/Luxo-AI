      "required": [
        "eventId",
        "title",
        "description",
        "category",
        "dateIso",
        "startTime",
        "endTime",
        "location",
        "speakerName",
        "capacity",
        "createdBy",
        "status",
        "createdAt",
        "updatedAt"
      ]
