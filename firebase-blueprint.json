          "maxLength": 4
        },
        "theme": {
          "type": "string",
          "description": "UI color theme preference.",
          "enum": ["system", "light", "dark"],
          "maxLength": 10
        },
        "voiceName": {
          "type": "string",
          "description": "Preferred voice persona.",
          "minLength": 1,
          "maxLength": 30
        },
        "voiceRate": {
          "type": "number",
          "description": "Speech playback rate."
        },
        "customTone": {
          "type": "string",
          "description": "Selected response tone.",
          "minLength": 1,
          "maxLength": 40
        },
        "customInstructions": {
          "type": "string",
          "description": "Custom instructions configured by user.",
          "maxLength": 1500
        },
        "workspaceType": {
          "type": "string",
          "description": "Selected workspace category.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "avatarText",
        "theme",
        "voiceName",
        "voiceRate",
        "customTone",
        "customInstructions",
        "workspaceType",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicSocialProfile": {
